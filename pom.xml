<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.estacio</groupId>
	<artifactId>mvc-aula2</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>mvc-aula2</name>
	<description>Projeto de exemplo - Aulas 2 a 5 - Arquitetura MVC, JPA/Hibernate, H2 e Lombok</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- Cria a aplicacao web e os endpoints REST (camada Controller) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Acesso a banco de dados via JPA/Hibernate (usaremos a partir da proxima aula) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Banco de dados H2. Aula 5: scope volta a ser o padrao (compile) porque
		     MvcAula2Application usa org.h2.tools.Server diretamente no codigo da aplicacao -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>

		<!-- Reinicio automatico da aplicacao a cada alteracao no codigo -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Aula 5 (Bloco 3): gera getters/setters/toString/equals/hashCode/construtores
		     em tempo de compilacao. optional=true -> so atua na compilacao, nao entra no artefato final -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Dependencias de teste (scope test: nao vao para o artefato final) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
